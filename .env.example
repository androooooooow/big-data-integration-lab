# Copy this file to .env, fill in your Atlas credentials, then run: npm start
PORT=3000

# Percent-encode special characters in the username and password.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.19yvzrp.mongodb.net/?appName=Cluster0

# Optional resolvers for Atlas SRV lookup when system DNS fails.
DNS_SERVERS=8.8.8.8,8.8.4.4
